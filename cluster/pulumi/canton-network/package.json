{
  "name": "@canton-network/canton-network-pulumi-deployment",
  "version": "1.0.0",
  "main": "src/index.ts",
  "dependencies": {
    "@canton-network/splice-pulumi-common": "1.0.0",
    "@canton-network/splice-pulumi-common-sv": "1.0.0",
    "@canton-network/splice-pulumi-common-validator": "1.0.0",
