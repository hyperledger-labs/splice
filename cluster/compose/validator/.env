IMAGE_REPO=ghcr.io/digital-asset/decentralized-canton-sync/docker/

# Versions
SPLICE_POSTGRES_VERSION=14.24-trixie
NGINX_VERSION=1.27.1
WALLET_GATEWAY_IMAGE_REPO=ghcr.io/digital-asset/wallet-gateway/docker/
WALLET_GATEWAY_VERSION=1.11.1
PORTFOLIO_IMAGE_REPO=ghcr.io/digital-asset/splice-portfolio/docker/
PORTFOLIO_VERSION=1.12.2

# Database
SPLICE_DB_USER=cnadmin
SPLICE_DB_PASSWORD=supersafe
SPLICE_DB_SERVER=postgres-splice
SPLICE_DB_PORT=5432

# Participant & validator admin
PARTICIPANT_IDENTIFIER=
PARTY_HINT=

# Validator
CONTACT_POINT=

# Traffic topups
TARGET_TRAFFIC_THROUGHPUT=20000
MIN_TRAFFIC_TOPUP_INTERVAL=1m

# Authentication
AUTH_URL=""
AUTH_JWKS_URL=""
AUTH_WELLKNOWN_URL=""
LEDGER_API_AUTH_AUDIENCE="https://canton.network.global"
LEDGER_API_AUTH_SCOPE=""
VALIDATOR_AUTH_AUDIENCE="https://canton.network.global"
VALIDATOR_AUTH_CLIENT_ID=""
VALIDATOR_AUTH_CLIENT_SECRET=""
LEDGER_API_ADMIN_USER=""
WALLET_ADMIN_USER=""
WALLET_UI_CLIENT_ID=""
ANS_UI_CLIENT_ID=""
WALLET_GATEWAY_UI_CLIENT_ID=""
AUTH_ISSUER=""
