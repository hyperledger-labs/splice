{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "defaultJvmOptions",
    "imageRepo",
    "participantAdminUserNameFrom",
    "persistence",
    "imageName"
  ],
  "properties": {
    "securityContexts": {
      "type": ["object"],
      "properties": {
        "pod": {
          "type": ["object"]
        },
        "containers": {
          "type": ["object"],
          "properties": {
            "participant": {
              "type": ["object"]
            },
            "persistence": {
              "type": ["object"]
            }
          },
          "required": ["participant", "persistence"]
        }
      },
      "required": ["pod", "containers"]
    },
    "serviceAccountName": {
      "type": "string"
    },
    "additionalEnvVars": {
      "type": "array"
    },
    "enableReloader": {
      "type": "boolean"
    },
    "extraInitContainers": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "jsonApiServerPathPrefix": {
      "type": "string"
    },
    "kms": {
      "type": "object"
    },
    "pvc": {
      "type": "object"
    },
    "logLevel": {
      "type": "string"
    },
    "logLevelStdout": {
      "type": "string"
    },
    "apiRequestLogLevel": {
      "type": "string"
    },
    "logAsyncFlush": {
      "type": "boolean"
    },
    "splice-util-lib": {
      "type": "object"
    },
    "cluster": {
      "type": "object"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "imageRepo": {
      "type": "string"
    },
    "imageName": {
      "type": "string"
    },
    "imageDigests": {
      "type": "object"
    },
    "imagePullPolicy": {
      "type": "string"
    },
    "defaultJvmOptions": {
      "type": "string"
    },
    "additionalJvmOptions": {
      "type": "string"
    },
    "additonalEnvVars": {
      "type": "object"
    },
    "enableHealthProbes": {
      "type": "boolean"
    },
    "enablePostgresMetrics": {
      "type": "boolean"
    },
    "livenessProbeInitialDelaySeconds": {
      "type": "integer"
    },
    "pod": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["host", "schema", "secretName", "initImageName"],
      "properties": {
        "databaseName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bootstrapDatabaseName": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "initImageName": {
          "type": "string"
        },
        "enablePgInitContainer": {
          "type": "boolean"
        },
        "enableParticipantDbConflictCheck": {
          "type": "boolean"
        },
        "secretOverrides": {
          "type": "object",
          "properties": {
            "postgresPassword": {
              "type": "string"
            }
          }
        }
      }
    },
    "participantAdminUserNameFrom": {
      "type": "object",
      "required": ["secretKeyRef"],
      "properties": {
        "secretKeyRef": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["jwksUrl", "targetAudience"],
      "properties": {
        "jwksUrl": {
          "type": "string"
        },
        "targetAudience": {
          "type": "string"
        },
        "secretOverrides": {
          "type": "object",
          "properties": {
            "ledgerApiUser": {
              "type": "string"
            }
          }
        }
      }
    },
    "disableAuth": {
      "type": "boolean"
    },
    "if": {
      "properties": {
        "disableAuth": {
          "const": "true"
        }
      }
    },
    "then": {
      "required": [
        "auth"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "release": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+[smh]$"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": ["number", "string"]
            },
            "memory": {
              "type": ["number", "string"]
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": ["number", "string"]
            },
            "memory": {
              "type": ["number", "string"]
            }
          }
        }
      }
    },
    "tolerations": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    }
  }
}
